# Legal Chatbot API (legal-chatbot FastAPI)

# Option A — Direct API (recommended when backend has CORS enabled)
# Network tab shows: http://YOUR-HOST:8000/api/v1/...
VITE_API_ORIGIN=http://172.16.112.24:8000

# Option B — Vite dev proxy (avoids CORS; network tab shows localhost:5173/api/v1/...)
# VITE_API_BASE_URL=/api/v1
# API_PROXY_TARGET=http://172.16.112.24:8000

# Optional: json-server (or other mock) for dashboard-only data.
VITE_MOCK_API_URL=http://localhost:3001
