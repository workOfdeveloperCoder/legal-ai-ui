# Legal Chatbot API (legal-chatbot FastAPI).
# In local dev, leave this as /api/v1 and use the Vite proxy in vite.config.js.
VITE_API_BASE_URL=/api/v1

# Optional: json-server (or other mock) for dashboard-only data.
# Leave empty to skip dashboard fetch gracefully.
VITE_MOCK_API_URL=http://localhost:3001
